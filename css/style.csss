body {
    margin: 0;
    font-family: Arial, sans-serif;
}

header {
    text-align: center;
    padding: 20px;
    background-color: #1e2a38;
    color: white;
}

main {
    padding: 20px;
}

.map-container {
    position: relative;
    width: 100%;
    padding-bottom: 65%; /* 지도 비율 */
    height: 0;
}

.map-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
}

footer {
    text-align: center;
    padding: 10px;
    background-color: #f0f0f0;
    font-size: 14px;
}
